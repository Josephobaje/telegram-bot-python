# Get a token from @BotFather on Telegram. Never commit your real .env file.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Optional: JSON endpoint returning {"rates": {"USD": 1, "NGN": ...}} for live exchange rates
RATES_API_URL=
# Optional: details shown by /contact. Leave empty to use the defaults
# (Joseph Obaje, josephobaje264@gmail.com, https://github.com/Josephobaje). Phone has no default and is hidden when empty.
CONTACT_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_URL=
